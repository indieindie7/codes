#exec NEW StaticMesh FILE=Gibs\seekerinfantry_torso_upper.ase NAME=seekerinfantry_torso_upper GROUP=Gibs

struct GibPart
{
	var name Set;
	var StaticMesh Mesh;
	var vector Pivot, Size;
	var float Mass;
};

struct GibSet
{
	var name Name;
	var string Skin;
	var float Height;
};

var array<GibPart> Parts;
var array<GibSet> Sets;

