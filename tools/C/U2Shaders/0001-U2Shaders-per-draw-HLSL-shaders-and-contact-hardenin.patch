+		FixedFunction = reinterpret_cast<VertexShaderInfo *>(CurrentVertexShaderHandle << 1)->Shader == nullptr;
+	U2.LogTargetDraw(ProxyInterface, FixedFunction, U2Stage0 != nullptr);
