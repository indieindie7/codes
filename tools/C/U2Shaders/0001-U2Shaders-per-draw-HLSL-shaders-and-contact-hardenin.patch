 	ProxyInterface->DrawIndexedPrimitive(PrimitiveType, CurrentBaseVertexIndex, MinIndex, NumVertices, StartIndex, PrimitiveCount);
+	if (Shaded)
+		U2.End(ProxyInterface);
 	return D3D_OK;
 }
